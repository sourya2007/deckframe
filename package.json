{
  "name": "deckframe",
  "version": "1.0.0",
  "description": "Screen recorder and 3D video editor",
  "author": "DeckFrame Team",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "prebuild": "node scripts/generate-icon.js",
    "build": "tsc -p tsconfig.main.json && vite build",
    "smoke": "tsc src/lib/timeline.ts src/lib/history.ts --outDir .tmp-smoke --module commonjs --target ES2022 --skipLibCheck && node scripts/_timeline-smoke.js .tmp-smoke/timeline.js && node scripts/_history-smoke.js .tmp-smoke/history.js",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish=never"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.4",
    "@react-three/fiber": "^8.17.14",
    "@react-three/postprocessing": "^2.16.3",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^1.3.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.173.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
